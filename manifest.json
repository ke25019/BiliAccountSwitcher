{
  "manifest_version": 3,
  "name": "B站多账号切换",
  "version": "1.1.8",
  "version_name": "1.1.8-beta",
  "description": "B站网页端多账号切换小助手，在用户菜单里加个“切换账号”，方便在几个号之间来回切。",
  "author": "ke25019",
  "homepage_url": "https://github.com/ke25019/BiliAccountSwitcher",
  "permissions": [
    "storage",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://bilibili.com/*",
    "*://passport.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://bilibili.com/*"
      ],
      "exclude_matches": [
        "*://passport.bilibili.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://passport.bilibili.com/*"
      ],
      "js": ["login.js"],
      "css": ["login.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
